# Copy this file to ".env" and fill in your own values.
# The .env file is ignored by git, so your secrets stay on your machine.

# Port the API listens on. Hosts such as Render set this automatically.
PORT=4000

# Local MongoDB, or your MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/learning-platform

# Secret used to sign login tokens. Use a long random value.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# How long a login lasts before the user must log in again.
JWT_EXPIRES_IN=7d

# The website(s) allowed to call this API (CORS). Separate several with commas.
CLIENT_URL=http://localhost:5173

# Set to "production" on your host. The seed script refuses to run in production.
NODE_ENV=development
